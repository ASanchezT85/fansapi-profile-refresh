APP_NAME="Profile Refresh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fansapi
DB_USERNAME=fansapi
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Must stay above the longest job timeout (config/refresh.php job_timeout_seconds).
REDIS_QUEUE_RETRY_AFTER=90

SCOUT_DRIVER=database

# Upstream profile provider. Locally it points at the fake upstream served by the `web` container.
UPSTREAM_BASE_URL=http://web:8000/fake-upstream
UPSTREAM_TOKEN=local-fake-token
FAKE_UPSTREAM_ENABLED=true

# Local only: lets `php artisan refresh:crash-demo` kill a worker after its DB write.
REFRESH_CHAOS_ENABLED=true

# Real provider (FansAPI / OnlyFans API) for `php artisan refresh:live`. Leave empty to stay offline.
FANSAPI_BASE_URL=https://app.onlyfansapi.com/api
FANSAPI_KEY=
